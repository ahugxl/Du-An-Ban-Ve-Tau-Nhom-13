<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="control.Controller_DanhMuc_TaiKhoan"
	stylesheets="@GD_DanhMuc_TaiKhoan.css" minHeight="0" minWidth="0">

	<top>
		<VBox spacing="10" styleClass="trenTK">
			<padding>
				<Insets top="15" right="20" bottom="15" left="20" />
			</padding>

			<Label styleClass="tieude" text="QUẢN LÝ TÀI KHOẢN" />

			<HBox alignment="CENTER_LEFT" spacing="10">
				<Label styleClass="lblTim" text="Tìm kiếm:" />
				<TextField fx:id="txtTim" prefWidth="300.0"
					promptText="Nhập tên tài khoản hoặc email..." styleClass="txtTim" />
				<Button onAction="#tim" styleClass="btnTim" text="Tìm kiếm">
					<padding>
						<Insets top="5" right="15" bottom="5" left="15" />
					</padding>
				</Button>
			</HBox>
		</VBox>
	</top>

	<left>
		<VBox spacing="10" styleClass="formNhap" prefWidth="300.0">
			<padding>
				<Insets top="15" right="15" bottom="15" left="15" />
			</padding>

			<Label styleClass="h2" text="Thông tin tài khoản" />

			<VBox spacing="5">
				<Label styleClass="lbl_Form" text="Tên tài khoản:" />
				<TextField fx:id="txtTenTaiKhoan" editable="false"
					id="txtTenTaiKhoan" promptText="" styleClass="txt_FormTK" />
			</VBox>

			<VBox spacing="5">
				<Label styleClass="lbl_Form" text="Email:" />
				<TextField fx:id="txtEmail" promptText="Nhập email"
					styleClass="txt_FormTK" />
			</VBox>

			<VBox spacing="5">
				<Label styleClass="lbl_Form" text="Role:" />
				<TextField fx:id="txtRole" editable="false"
					id="txtRole" promptText="" styleClass="txt_FormTK" />
			</VBox>

			<Label styleClass="lblInfo"
				text="⚠️ Mật khẩu mặc định sẽ được tạo tự động khi thêm tài khoản"
				wrapText="true" />

			<!-- Buttons -->

			<Button fx:id="btnSua" managed="false" maxWidth="Infinity"
				onAction="#sua" styleClass="btnSua" text="Cập nhật tài khoản"
				visible="false">
				<padding>
					<Insets top="10" right="10" bottom="10" left="10" />
				</padding>
			</Button>

			<Button fx:id="btnXoaThongTin" maxWidth="Infinity"
				onAction="#xoaThongTin" styleClass="btnXoaThongTin"
				text="Xóa thông tin">
				<padding>
					<Insets top="10" right="10" bottom="10" left="10" />
				</padding>
			</Button>
		</VBox>
	</left>

	<!-- CENTER: Account Table -->
	<center>
		<VBox spacing="10" styleClass="tb">
			<padding>
				<Insets top="15" right="15" bottom="15" left="15" />
			</padding>

			<Label styleClass="h2" text="Danh sách tài khoản" />

			<TableView fx:id="tbTaiKhoan" styleClass="tbTaiKhoan"
				VBox.vgrow="ALWAYS">
				<columns>
					<TableColumn fx:id="colTenTaiKhoan" prefWidth="150.0"
						text="Tên tài khoản" />
					<TableColumn fx:id="colEmail" prefWidth="200.0"
						text="Email" />
					<TableColumn fx:id="colChucVu" prefWidth="130.0"
						text="Role" />
					<TableColumn fx:id="colThaoTac" prefWidth="200.0"
						sortable="false" text="Thao tác" />
				</columns>
				<columnResizePolicy>
					<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
				</columnResizePolicy>
			</TableView>
		</VBox>
	</center>

</BorderPane>