<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="720.0" prefWidth="1280.0" stylesheets="@CapNhatThue.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.Controller_QuanLyThue">
   <top>
      <HBox styleClass="header-pane" alignment="CENTER" prefHeight="60.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="CẬP NHẬT THUẾ" styleClass="title-label" style="-fx-font-size: 22px;"/>
         </children>
      </HBox>
   </top>
   <left>
      <VBox styleClass="sidebar" prefWidth="350.0" spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Thông tin thuế">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Label text="Mã số thuế:" />
            <TextField fx:id="txtMaThue" promptText="Ví dụ: VAT10" />
            <Label text="Tên thuế:" />
            <TextField fx:id="txtTenThue" promptText="Ví dụ: Thuế GTGT 10%" />
            <Label text="Mức thuế (%):" />
            <TextField fx:id="txtMucThue" promptText="Ví dụ: 0.1 (cho 10%)" />
            <Label text="Trạng thái:" />
            <ComboBox fx:id="cmbTrangThai" prefWidth="310.0" />
            <Label text="Ngày bắt đầu:" />
            <DatePicker fx:id="dateNgayBatDau" prefWidth="310.0" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnThem" onAction="#handleThem" prefWidth="90.0" styleClass="success-button" text="Thêm" />
                  <Button fx:id="btnSua" onAction="#handleSua" prefWidth="90.0" styleClass="primary-button" text="Sửa" />
                  <Button fx:id="btnXoaRong" onAction="#handleXoaRong" prefWidth="90.0" text="Xóa rỗng" />
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Danh sách các loại thuế">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <TableView fx:id="tblThue" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colMaThue" prefWidth="100.0" text="Mã số thuế" />
                  <TableColumn fx:id="colTenThue" prefWidth="250.0" text="Tên thuế" />
                  <TableColumn fx:id="colMucThue" prefWidth="100.0" text="Mức thuế" />
                  <TableColumn fx:id="colTrangThai" prefWidth="150.0" text="Trạng thái" />
                  <TableColumn fx:id="colNgayBatDau" prefWidth="150.0" text="Ngày bắt đầu" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>